class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {
        unordered_map<int,int>freq;
        for(int x:arr){
            ++freq[x];
        }

        unordered_set<int>seenCounts;
        for(const auto& [val,count]:freq) {
            if(!seenCounts.insert(count).second) {
                return false;
            }
        }

        return true;
    }
};
